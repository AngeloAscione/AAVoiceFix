# Copia questo file in keystore.properties (ignorato da git) e genera la chiave:
#
#   mkdir -p keystore
#   keytool -genkeypair -v \
#     -keystore keystore/aawafixer-release.jks \
#     -alias aawafixer \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -dname "CN=AA Voice Fix, OU=Community, O=AA Voice Fix, C=IT"
#
# La password va scelta a mano e conservata insieme al keystore:
# senza la stessa chiave non si possono firmare aggiornamenti compatibili.

storeFile=keystore/aawafixer-release.jks
storePassword=CHANGE_ME
keyAlias=aawafixer
keyPassword=CHANGE_ME
